{
  "name": "@opengewerk/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate.js",
    "add-staff": "node dist/add-staff.js",
    "reset-password": "node dist/reset-password.js",
    "preview": "tsc -p tsconfig.preview.json && node --enable-source-maps preview-build/preview/preview.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@fontsource/barlow": "5.3.0",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@node-rs/argon2": "2.2.1",
    "@opengewerk/domain": "workspace:*",
    "@opengewerk/gewerk-elektro": "workspace:*",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "libxml2-wasm": "0.7.2",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuidv7": "1.2.1"
  },
  "devDependencies": {
    "@better-auth/utils": "0.5.0",
    "@nestjs/testing": "12.0.3",
    "@types/express": "5.0.6",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.10",
    "supertest": "7.2.2",
    "vitest": "5.0.1"
  }
}
