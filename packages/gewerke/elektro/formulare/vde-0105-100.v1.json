{
  "key": "vde-0105-100",
  "version": 1,
  "title": "Prüfprotokoll Wiederholungsprüfung nach DIN VDE 0105-100",
  "attachesTo": "installation",
  "sections": [
    {
      "key": "general",
      "title": "Prüfung",
      "fields": [
        { "kind": "text", "key": "tester", "label": "Prüfer", "required": true, "carry": true },
        {
          "kind": "text",
          "key": "instrument",
          "label": "Messgerät",
          "carry": true,
          "hint": "Hersteller, Typ und Seriennummer."
        },
        {
          "kind": "choice",
          "key": "earthing_system",
          "label": "Netzform",
          "required": true,
          "carry": true,
          "options": [
            { "value": "tn_c", "label": "TN-C" },
            { "value": "tn_s", "label": "TN-S" },
            { "value": "tn_c_s", "label": "TN-C-S" },
            { "value": "tt", "label": "TT" },
            { "value": "it", "label": "IT" }
          ]
        },
        {
          "kind": "number",
          "key": "nominal_voltage",
          "label": "Nennspannung",
          "carry": true,
          "unit": "volt",
          "decimals": 0
        }
      ]
    },
    {
      "key": "inspection",
      "title": "Besichtigen",
      "hint": "DIN VDE 0105-100/A1, Abschnitt 5.3, die Punkte nach DGUV Information 203-072.",
      "fields": [
        {
          "kind": "choice",
          "key": "previous_report",
          "label": "Prüfprotokoll der vorangegangenen Prüfung",
          "required": true,
          "options": [
            { "value": "ok", "label": "in Ordnung" },
            { "value": "defect", "label": "Mangel" },
            { "value": "not_applicable", "label": "entfällt" }
          ]
        },
        {
          "kind": "choice",
          "key": "documentation",
          "label": "Unterlagen vorhanden und aktuell, Stromkreisverzeichnis und Schaltpläne",
          "required": true,
          "options": [
            { "value": "ok", "label": "in Ordnung" },
            { "value": "defect", "label": "Mangel" },
            { "value": "not_applicable", "label": "entfällt" }
          ]
        },
        {
          "kind": "choice",
          "key": "identification",
          "label": "Kennzeichnung von Stromkreisen, Schutz- und Neutralleitern",
          "required": true,
          "options": [
            { "value": "ok", "label": "in Ordnung" },
            { "value": "defect", "label": "Mangel" },
            { "value": "not_applicable", "label": "entfällt" }
          ]
        },
        {
          "kind": "choice",
          "key": "accessibility",
          "label": "Zugang zu Bedienung und Wartung, Fluchtwege frei",
          "required": true,
          "options": [
            { "value": "ok", "label": "in Ordnung" },
            { "value": "defect", "label": "Mangel" },
            { "value": "not_applicable", "label": "entfällt" }
          ]
        },
        {
          "kind": "choice",
          "key": "basic_protection",
          "label": "Basisschutz, Schutz gegen direktes Berühren",
          "required": true,
          "options": [
            { "value": "ok", "label": "in Ordnung" },
            { "value": "defect", "label": "Mangel" },
            { "value": "not_applicable", "label": "entfällt" }
          ]
        },
        {
          "kind": "choice",
          "key": "bonding",
          "label": "Schutzleiter, Erdung und Schutzpotentialausgleich angeschlossen",
          "required": true,
          "options": [
            { "value": "ok", "label": "in Ordnung" },
            { "value": "defect", "label": "Mangel" },
            { "value": "not_applicable", "label": "entfällt" }
          ]
        },
        {
          "kind": "choice",
          "key": "protective_devices",
          "label": "Auswahl und Einstellung der Schutz- und Überwachungseinrichtungen",
          "required": true,
          "options": [
            { "value": "ok", "label": "in Ordnung" },
            { "value": "defect", "label": "Mangel" },
            { "value": "not_applicable", "label": "entfällt" }
          ]
        },
        {
          "kind": "choice",
          "key": "condition",
          "label": "Zustand von Betriebsmitteln, Kabeln und Leitungen",
          "required": true,
          "options": [
            { "value": "ok", "label": "in Ordnung" },
            { "value": "defect", "label": "Mangel" },
            { "value": "not_applicable", "label": "entfällt" }
          ]
        }
      ]
    },
    {
      "key": "trial",
      "title": "Erproben",
      "fields": [
        {
          "kind": "choice",
          "key": "rcd_test_button",
          "label": "Prüftaste der Fehlerstromschutzeinrichtungen",
          "required": true,
          "options": [
            { "value": "ok", "label": "in Ordnung" },
            { "value": "defect", "label": "Mangel" },
            { "value": "not_applicable", "label": "entfällt" }
          ]
        },
        {
          "kind": "choice",
          "key": "switchgear",
          "label": "Funktion von Schalt-, Steuer- und Verriegelungseinrichtungen",
          "required": true,
          "options": [
            { "value": "ok", "label": "in Ordnung" },
            { "value": "defect", "label": "Mangel" },
            { "value": "not_applicable", "label": "entfällt" }
          ]
        },
        {
          "kind": "choice",
          "key": "motor_rotation",
          "label": "Drehrichtung von Motoren",
          "options": [
            { "value": "ok", "label": "in Ordnung" },
            { "value": "defect", "label": "Mangel" },
            { "value": "not_applicable", "label": "entfällt" }
          ]
        }
      ]
    },
    {
      "key": "measurements",
      "title": "Messen",
      "hint": "DIN VDE 0105-100/A1, je Stromkreis aus dem Stromkreisverzeichnis.",
      "fields": [
        {
          "kind": "group",
          "key": "circuits",
          "label": "Stromkreise",
          "repeat": "circuits",
          "fields": [
            {
              "kind": "measurement",
              "key": "protective_conductor",
              "label": "Durchgängigkeit des Schutzleiters RPE",
              "unit": "ohm",
              "decimals": 2
            },
            {
              "kind": "measurement",
              "key": "insulation_without_loads",
              "label": "Isolationswiderstand Riso ohne Verbraucher",
              "unit": "megaohm",
              "decimals": 3,
              "limit": { "kind": "at_least", "rule": "elektro.insulation.recurring_without_loads" }
            },
            {
              "kind": "measurement",
              "key": "insulation_with_loads",
              "label": "Isolationswiderstand Riso mit Verbrauchern",
              "unit": "megaohm",
              "decimals": 3,
              "limit": { "kind": "at_least", "rule": "elektro.insulation.recurring_with_loads" }
            },
            {
              "kind": "measurement",
              "key": "loop_impedance",
              "label": "Schleifenimpedanz Zs",
              "unit": "ohm",
              "decimals": 2,
              "limit": { "kind": "loop_impedance" }
            },
            {
              "kind": "measurement",
              "key": "rcd_trip_current",
              "label": "Auslösestrom IΔ",
              "unit": "milliampere",
              "decimals": 1,
              "limit": { "kind": "rcd_trip_current" }
            },
            {
              "kind": "measurement",
              "key": "rcd_trip_time",
              "label": "Auslösezeit tΔ",
              "unit": "millisecond",
              "decimals": 0,
              "limit": { "kind": "at_most", "rule": "elektro.rcd.trip_time_maximum" }
            },
            {
              "kind": "choice",
              "key": "phase_sequence",
              "label": "Drehfeld",
              "options": [
                { "value": "clockwise", "label": "rechts" },
                { "value": "counterclockwise", "label": "links" },
                { "value": "not_applicable", "label": "entfällt" }
              ]
            },
            { "kind": "text", "key": "remark", "label": "Bemerkung", "multiline": true }
          ]
        }
      ]
    },
    {
      "key": "result",
      "title": "Ergebnis",
      "fields": [
        {
          "kind": "choice",
          "key": "verdict",
          "label": "Ergebnis",
          "required": true,
          "options": [
            { "value": "passed", "label": "Keine Mängel festgestellt" },
            { "value": "defects", "label": "Mängel festgestellt" }
          ]
        },
        { "kind": "text", "key": "defects", "label": "Mängel", "multiline": true },
        {
          "kind": "number",
          "key": "next_inspection_months",
          "label": "Prüffrist bis zur nächsten Prüfung",
          "required": true,
          "carry": true,
          "unit": "month",
          "decimals": 0,
          "hint": "Legt der Betreiber nach seiner Gefährdungsbeurteilung fest. Prüffristen nach Tabelle 1A der Durchführungsanweisungen zu § 5 der DGUV Vorschrift 3: 48 Monate, in Betriebsstätten, Räumen und Anlagen besonderer Art 12 Monate."
        },
        { "kind": "photo", "key": "photo", "label": "Foto" },
        {
          "kind": "signature",
          "key": "tester_signature",
          "label": "Unterschrift des Prüfers",
          "seals": true
        }
      ]
    }
  ]
}
