            },
            {
              "value": "not_applicable",
              "label": "entfällt"
            }
          ]
        },
        {
          "kind": "choice",
          "key": "fire_protection",
          "label": "Nicht in Rettungswegen, Abstand zu brennbaren Stoffen",
