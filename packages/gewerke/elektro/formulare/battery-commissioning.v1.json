          "options": [
            {
              "value": "ok",
              "label": "in Ordnung"
            },
            {
              "value": "defect",
              "label": "Mangel"
            },
            {
              "value": "not_applicable",
              "label": "entfällt"
            }
          ]
        },
        {
          "kind": "choice",
          "key": "location",
          "label": "Aufstellort zulässig: Raum, Untergrund, Abstände und Belüftung",
          "required": true,
          "options": [
            {
              "value": "ok",
              "label": "in Ordnung"
            },
            {
              "value": "defect",
              "label": "Mangel"
            },
            {
              "value": "not_applicable",
              "label": "entfällt"
            }
          ]
        },
        {
          "kind": "choice",
          "key": "temperature",
          "label": "Umgebungstemperatur im zulässigen Bereich",
          "required": true,
          "options": [
            {
              "value": "ok",
              "label": "in Ordnung"
            },
            {
              "value": "defect",
