            {
              "value": "defect",
              "label": "Mangel"
            },
            {
              "value": "not_applicable",
              "label": "entfällt"
            }
          ]
        },
        {
          "kind": "choice",
          "key": "wiring",
          "label": "Leitungen, Absicherung und Trennstelle nach Herstellerangaben",
          "required": true,
          "options": [
            {
              "value": "ok",
              "label": "in Ordnung"
            },
            {
              "value": "defect",
              "label": "Mangel"
            },
            {
              "value": "not_applicable",
              "label": "entfällt"
            }
          ]
        },
        {
          "kind": "choice",
          "key": "labelling",
          "label": "Kennzeichnung für Einsatzkräfte am Hausanschluss oder an der Verteilung",
          "required": true,
          "options": [
            {
              "value": "ok",
              "label": "in Ordnung"
            },
            {
              "value": "defect",
              "label": "Mangel"
            },
            {
              "value": "not_applicable",
              "label": "entfällt"
            }
          ]
        }
      ]
    },
    {
      "key": "commissioning",
      "title": "Inbetriebnahme",
      "fields": [
        {
          "kind": "text",
          "key": "firmware",
          "label": "Firmware",
          "hint": "Stand von Speicher und Wechselrichter bei der Inbetriebnahme."
        },
        {
          "kind": "choice",
          "key": "communication",
          "label": "Kommunikation zwischen Batteriemanagement und Wechselrichter",
          "required": true,
          "options": [
            {
              "value": "ok",
              "label": "in Ordnung"
            },
            {
              "value": "defect",
              "label": "Mangel"
            },
            {
              "value": "not_applicable",
              "label": "entfällt"
            }
          ]
        },
        {
          "kind": "number",
