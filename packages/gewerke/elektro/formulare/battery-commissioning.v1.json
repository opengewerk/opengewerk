        {
          "kind": "choice",
          "key": "backup_test",
          "label": "Umschaltung auf Ersatzstrom erprobt",
          "required": true,
          "options": [
            {
              "value": "ok",
              "label": "in Ordnung"
            },
            {
              "value": "defect",
              "label": "Mangel"
            },
            {
              "value": "not_applicable",
              "label": "entfällt"
            }
          ]
        },
        {
          "kind": "yes_no",
          "key": "registered",
          "label": "Beim Hersteller registriert",
          "hint": "Wo der Hersteller das für die Garantie verlangt."
        }
      ]
    },
    {
      "key": "handover",
      "title": "Übergabe",
      "fields": [
        {
          "kind": "yes_no",
          "key": "handed_over",
          "label": "Betreiber eingewiesen, Unterlagen übergeben",
          "required": true,
          "hint": "Bedienungsanleitung, Datenblatt und Garantiebedingungen."
        },
        {
          "kind": "text",
          "key": "remarks",
          "label": "Bemerkungen",
          "multiline": true
        },
        {
          "kind": "photo",
          "key": "photo",
          "label": "Foto"
        },
        {
          "kind": "signature",
          "key": "operator_signature",
