{
  "key": "battery-commissioning",
  "version": 1,
  "title": "Inbetriebnahmeprotokoll Batteriespeicher",
  "attachesTo": "installation",
  "installationKinds": ["battery"],
  "purpose": "commissioning",
  "fromStructure": {
    "operator": "operator",
    "storage": "installation",
    "usable_capacity": "usable_capacity",
    "rated_power": "rated_power"
  },
  "sections": [
    {
      "key": "storage",
      "title": "Speicher",
      "hint": "Nach den Angaben des Herstellers und VDE-AR-E 2510-2. Die Inbetriebsetzung am Netz hält das Protokoll nach VDE-AR-N 4105 fest.",
      "fields": [
        {
          "kind": "text",
          "key": "operator",
          "label": "Anlagenbetreiber",
          "hint": "Name und Anschrift, vorbelegt aus dem Kunden des Objekts.",
          "multiline": true,
          "required": true
        },
        {
          "kind": "text",
          "key": "storage",
          "label": "Speicher",
          "hint": "Hersteller, Typ und Seriennummer, vorbelegt aus der Anlage.",
          "multiline": true,
          "required": true
        },
        {
          "kind": "text",
          "key": "modules",
          "label": "Batteriemodule",
          "hint": "Anzahl und Seriennummern der Module.",
          "multiline": true
        },
        {
          "kind": "choice",
          "key": "technology",
          "label": "Batterietechnologie",
          "required": true,
          "options": [
            {
              "value": "lithium",
              "label": "Lithium-Ionen"
            },
            {
              "value": "lead",
              "label": "Blei"
            },
            {
              "value": "redox_flow",
              "label": "Redox-Flow"
            },
            {
              "value": "high_temperature",
              "label": "Hochtemperatur"
            },
            {
              "value": "nickel",
              "label": "Nickel-Cadmium oder Nickel-Metallhydrid"
            },
            {
              "value": "other",
              "label": "Sonstige"
            }
          ]
        },
        {
          "kind": "number",
          "key": "usable_capacity",
          "label": "Nutzbare Speicherkapazität",
          "hint": "Vorbelegt aus der Anlage.",
          "unit": "kilowatt_hour",
          "decimals": 2,
          "required": true
        },
        {
          "kind": "number",
          "key": "rated_power",
          "label": "Bemessungsleistung",
          "hint": "Mit der er lädt und entlädt, nach dem Datenblatt seines Wechselrichters.",
          "unit": "kilowatt",
          "decimals": 2,
          "required": true
        },
        {
          "kind": "choice",
          "key": "coupling",
          "label": "Kopplung",
          "required": true,
          "options": [
            {
              "value": "ac",
              "label": "AC-gekoppelt, mit eigenem Wechselrichter"
            },
            {
              "value": "dc",
              "label": "DC-gekoppelt, am Wechselrichter der PV-Anlage"
            }
          ]
        },
        {
          "kind": "choice",
          "key": "backup",
          "label": "Ersatzstrom",
          "required": true,
          "options": [
            {
              "value": "none",
              "label": "Keiner"
            },
            {
              "value": "emergency",
              "label": "Notstrom an einer Steckdose"
            },
            {
              "value": "backup",
              "label": "Ersatzstrom mit Umschaltung"
            },
            {
              "value": "island",
              "label": "Inselbetrieb"
            }
          ]
        }
      ]
    },
    {
