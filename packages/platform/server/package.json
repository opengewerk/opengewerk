{
  "name": "@opengewerk/platform-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "sql"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migration": {
      "types": "./dist/migration.d.ts",
      "default": "./dist/migration.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@opengewerk/platform-domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuidv7": "1.2.1"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.3",
    "@types/express": "5.0.6",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.10",
    "supertest": "7.2.2",
    "vitest": "5.0.1"
  }
}
