# Template for the .env next to the compose file. Nobody has to fill it in by
# hand: the first start copies it, makes every secret marked "bitte-ersetzen"
# and asks for the address. Only the names of what it made are printed.
#
#   sh docker/start.sh
#
# The .env is the only file holding credentials. It does not belong in the
# repository, the .gitignore keeps it out, and setup.sh makes it readable by
# its owner only. Every setting a business changes lives in the web interface,
# not here; what is here is needed before the interface can start.
#
# Whoever fills it in by hand makes every secret on its own, and an instance
# that still finds a placeholder refuses to start:
#
#   openssl rand -hex 32
#
# Hex and not base64, and that is not a matter of taste: the passwords end up
# inside connection strings, and a "/" or "@" in one splits the address at the
# wrong place. base64 produces both regularly. Whoever takes a special
# character anyway has to percent encode it in the address; OpenGewerk reports
# at startup when an address fell apart that way.

# The superuser of the database. The application never uses it, only the
# container itself while setting up.
POSTGRES_PASSWORD=bitte-ersetzen-1

# The role that owns the tables. It migrates, nothing else.
OPENGEWERK_OWNER_PASSWORD=bitte-ersetzen-2

# The role the application works with. Tenant isolation applies to it, which
# is why it is the only one allowed to see data.
OPENGEWERK_APP_PASSWORD=bitte-ersetzen-3

# The renderer wants a token, even on its own network.
RENDERER_TOKEN=bitte-ersetzen-4

# The optional services that start with the instance. "renderer" turns
# documents into PDFs: every quote, invoice and report a business prints or
# mails goes through it, and so does the ZUGFeRD PDF. It starts by default,
# because an installation without it cannot hand out a single PDF.
#
# It costs around 340 MB of memory and close to 4 GB of disk. Whoever really
# never needs a PDF switches it off with an empty value, "COMPOSE_PROFILES=",
# and not by deleting the line: setup.sh adds every line the template has and
# the .env lacks, so a deleted line is back after the next start. The backup
# service does not belong in here, it runs on demand, see below.
COMPOSE_PROFILES=renderer

# Signs the session cookies, encrypts the second factors and seals the
# passwords of the mail servers the businesses set up in the office. Same rule
# as above, "openssl rand -hex 32", and one more thing: this one belongs in the
# backup of the installation. Changing it signs everybody out, makes every TOTP
# secret that was already set up unreadable, and every mail password has to be
# entered again under "E-Mail-Einstellungen".
#
# The mail server itself is not set here. Each business sets up its own in the
# office, with its own mailbox and login.
SESSION_SECRET=bitte-ersetzen-5

# The addresses a browser may send an authenticated request from, separated by
# commas. Origin only: scheme, host, optional port, no path and no slash at the
# end, because that is what a browser puts in the Origin header and anything
# else never matches.
#
# This is the protection against a form on a stranger's page posting here with
# somebody's cookie attached. There is no default: one would switch it off in
# exactly the installation whose operator did not think about it.
TRUSTED_ORIGINS=https://opengewerk.example.de

# Recognises nobody while this is "true", the sign in included. The instance
# starts, migrates and answers its health check, and hands out no data at all.
# For a restore or a migration window. Anything other than "true" or "false" is
# refused rather than read as a no, so a typo cannot quietly open an instance.
CLOSED=false

# Mail servers in the network this instance runs in that a business may use,
# by name or address, separated by commas, on any port. Left empty, a business
# reaches mail servers on the internet only, on the ports for mail, and its
# settings cannot point at this machine, the database or anything else in the
# network. A boundary of the instance, which is why it is here and not among
# the settings a business makes in the office.
MAIL_INTERNAL_HOSTS=

# Which port the application answers on, on this machine. Loopback only; a
# reverse proxy with TLS belongs in front of it. 23700 and not 3000, because
# 3000 is taken on most machines that develop anything.
OPENGEWERK_PORT=23700

# Which state is running. For an update the new version goes here, followed by
# "sh docker/start.sh"; "latest" is convenient and tells nobody half a year
# later what is actually running.
OPENGEWERK_VERSION=latest

# --- Backup ---------------------------------------------------------------
# Only read by the backup service, which runs on demand:
#
#   docker compose --profile backup run --rm backup backup.sh
#   docker compose --profile backup run --rm backup restore.sh latest

# How many generations to keep. Older ones are removed after a run.
BACKUP_KEEP=14

# Where the archives land. A named volume by default, which survives a
# "docker compose down" but not the disk. An installation that means it puts
# an absolute path to another machine here, mounted over NFS or SMB:
#
#   BACKUP_TARGET=/mnt/nas/opengewerk
BACKUP_TARGET=backups

# The public key an archive is encrypted to. Leaving this empty writes the
# archive in the clear, and it holds customer data, invoices and the audit
# log. Create a key pair with:
#
#   docker run --rm opengewerk/backup:latest age-keygen
#
# The line starting with "age1" is the public key and goes here. The line
# starting with "AGE-SECRET-KEY-" is the private one: it belongs somewhere
# other than this machine, because a backup encrypted with a key that lies
# next to it protects against nothing.
BACKUP_AGE_RECIPIENT=

# Only needed to restore an encrypted archive, and only then. It points at a
# file holding the private key, mounted into the container for that one run:
#
#   docker compose --profile backup run --rm \
#     -v /pfad/zum/schluessel.txt:/schluessel.txt:ro \
#     -e BACKUP_AGE_IDENTITY=/schluessel.txt \
#     backup restore.sh latest
BACKUP_AGE_IDENTITY=
