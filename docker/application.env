# The names this application goes by in the scripts beside this file, in one
# place (opengewerk-haustechnik#14). setup.sh and start.sh are the
# foundation's: every application of the organisation sets up, starts and
# updates the same way, and what a person reads in them, or what is named after
# the application, comes from here. Shell syntax, read with "." by both
# scripts and never by Docker Compose. The name of the Compose project, the
# images and the default port stand in compose.yaml, the address the template
# carries until the real one is given in .env.example; the scripts read them
# there.

# What the application is called, at the start of every line the scripts say.
APPLICATION_NAME='OpenGewerk'

# The prefix of the variables that are the application's own, in the .env and
# in the environment of a script: OPENGEWERK_VERSION, OPENGEWERK_PORT and
# OPENGEWERK_ADDRESS. Two applications on one server keep their variables
# apart by it. Capital letters, digits and underscores, beginning with a
# letter.
APPLICATION_PREFIX='OPENGEWERK'

# An address the script names as an example when it asks for the real one.
APPLICATION_EXAMPLE_ADDRESS='https://opengewerk.meinbetrieb.de'
